# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/govfinder

# ─── Auth ───────────────────────────────────────────────
SECRET_KEY=your-secret-key-min-32-chars-long-here
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# ─── External APIs ──────────────────────────────────────
# data.go.kr 공공데이터포털 API 키 (https://www.data.go.kr/index.do)
DATA_GO_KR_API_KEY=your-data-go-kr-api-key

# OpenAI API (AI 요약용, https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key

# Anthropic API (AI 요약 폴백, https://console.anthropic.com/)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Resend (이메일 알림, https://resend.com/api-keys)
RESEND_API_KEY=your-resend-api-key

# ─── Admin ──────────────────────────────────────────────
ADMIN_EMAILS=admin@example.com
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com

# ─── CORS (쉼표 구분) ──────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Environment ────────────────────────────────────────
ENV=development

# ─── Frontend (Next.js) ────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
